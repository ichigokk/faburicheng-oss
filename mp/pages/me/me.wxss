.me-wrap { padding: 16rpx 24rpx 60rpx; }

.app-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16rpx 8rpx 8rpx;
  margin-bottom: 16rpx;
}
.header-text { display: flex; flex-direction: column; gap: 2rpx; }
.kicker { font-size: 22rpx; color: var(--muted); letter-spacing: 1rpx; }
.page-title { font-size: 40rpx; font-weight: 800; color: var(--text); letter-spacing: -0.5rpx; }

.profile-panel {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.section-title { font-size: 30rpx; font-weight: 800; color: var(--text); }

.pill {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-strong);
}
.pill.ok { background: #d8efd8; color: #196b1f; }
.pill.warn { background: #ffeacc; color: #8a5318; }
.pill.risk { background: var(--red-soft); color: var(--red); }

.muted { color: var(--muted); font-size: 24rpx; }

.primary-button {
  background: var(--brand);
  color: white;
  border: none;
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.text-button {
  background: var(--surface-3);
  color: var(--brand-strong);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.text-button.danger {
  background: var(--red-soft);
  color: var(--red);
  border-color: var(--red-soft);
}

/* 客户管理 */
.manage-add-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  background: var(--surface-3);
  border: 1rpx dashed var(--line-strong);
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}
.add-text { display: flex; flex-direction: column; gap: 4rpx; }
.add-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.add-arrow { color: var(--brand-strong); font-weight: 700; }

.client-form {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 14rpx;
  background: var(--surface-2);
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}
.form-input {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }

.client-list { display: flex; flex-direction: column; gap: 10rpx; }
.client-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 12rpx;
  background: var(--surface-3);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
}
.avatar-mark {
  width: 56rpx; height: 56rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: white;
  text-align: center;
  line-height: 56rpx;
  font-weight: 800;
  font-size: 26rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-mark text {
  display: inline-block;
  width: 100%; height: 100%;
  white-space: nowrap; overflow: hidden;
  text-overflow: ellipsis;
}
.client-info { display: flex; flex-direction: column; gap: 4rpx; flex: 1; min-width: 0; }
.client-name { font-size: 28rpx; font-weight: 700; color: var(--text); }

.empty-state {
  padding: 32rpx 16rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--radius-md);
  text-align: center;
  color: var(--muted);
}

/* LLM */
.llm-list { display: flex; flex-direction: column; gap: 12rpx; }
.llm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  background: var(--surface-3);
  border-radius: 12rpx;
}
.llm-name { font-weight: 700; }

/* ICP */
.icp-footer {
  margin-top: 24rpx;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
}
