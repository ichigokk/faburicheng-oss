.stats-wrap { padding: 16rpx 24rpx 80rpx; }

.app-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16rpx 8rpx 8rpx;
  margin-bottom: 16rpx;
}
.header-text { display: flex; flex-direction: column; gap: 2rpx; }
.kicker { font-size: 22rpx; color: var(--muted); letter-spacing: 1rpx; }
.page-title { font-size: 40rpx; font-weight: 800; color: var(--text); letter-spacing: -0.5rpx; }
.detail-header { padding-top: 8rpx; gap: 12rpx; }
.back-button {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--brand-strong);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
}

/* 总览 */
.overview-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 22rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}
.ov-cell { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.mini-label { font-size: 22rpx; color: var(--muted); }
.ov-num { font-size: 42rpx; font-weight: 800; color: var(--text); letter-spacing: -0.5rpx; }
.ov-num.warn { color: var(--red); }

/* section head */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 24rpx 8rpx 12rpx;
}
.section-title { font-size: 28rpx; font-weight: 800; color: var(--text); }
.muted { color: var(--muted); font-size: 22rpx; }

/* stat-card */
.stat-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 22rpx 22rpx 18rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.stat-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.stat-head-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.stat-name { font-size: 30rpx; font-weight: 800; color: var(--text); }

.avatar-mark {
  width: 64rpx; height: 64rpx;
  border-radius: 999rpx;
  color: white;
  text-align: center;
  line-height: 64rpx;
  font-weight: 800;
  font-size: 28rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-mark.md { width: 72rpx; height: 72rpx; line-height: 72rpx; font-size: 30rpx; }
.avatar-mark.lg { width: 110rpx; height: 110rpx; line-height: 110rpx; font-size: 44rpx; }
.avatar-mark text {
  display: inline-block;
  width: 100%;
  height: 100%;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pill {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-strong);
  white-space: nowrap;
}
.pill.warn { background: #ffeacc; color: #8a5318; }
.pill.risk { background: var(--red-soft); color: var(--red); }
.pill.ok { background: #d8efd8; color: #196b1f; }

.stock-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 14rpx;
}
.stock-num { display: flex; flex-direction: column; min-width: 96rpx; }
.big { font-size: 36rpx; font-weight: 800; color: var(--text); letter-spacing: -0.5rpx; }
.progress-track {
  flex: 1;
  height: 14rpx;
  background: var(--surface-2);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand), var(--amber));
  border-radius: 999rpx;
}

.stat-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.metric { display: flex; flex-direction: column; align-items: center; gap: 4rpx; padding: 10rpx 4rpx; background: var(--surface-3); border-radius: 12rpx; }

.deadline { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--muted); padding: 0 4rpx; }
.deadline .strong { color: var(--brand-strong); font-weight: 700; }

/* 详情 */
.detail-hero {
  display: flex;
  gap: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.hero-text { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.hero-name { font-size: 36rpx; font-weight: 800; }
.hero-cover { display: flex; align-items: baseline; gap: 10rpx; padding: 8rpx 0; }
.hero-num { font-size: 48rpx; font-weight: 800; color: var(--brand); }
.hero-pill { margin-left: auto; align-self: center; }

.detail-section {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  padding: 22rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}
.detail-section .section-title { display: block; margin-bottom: 12rpx; }
.account-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; }
.platform-tag {
  background: var(--surface-3);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-soft);
}
.account-nick { font-weight: 700; color: var(--text); }

.event-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 14rpx 16rpx;
  background: var(--surface-3);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  margin-top: 10rpx;
}
.event-main { flex: 1; display: flex; flex-direction: column; gap: 2rpx; min-width: 0; }
.event-title { font-size: 26rpx; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-sub { font-size: 22rpx; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.empty-state {
  padding: 48rpx 24rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--radius-md);
  text-align: center;
  color: var(--muted);
  margin-top: 80rpx;
}
.primary-button {
  display: inline-block;
  margin-top: 24rpx;
  background: var(--brand);
  color: white;
  border: none;
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  font-weight: 700;
}
