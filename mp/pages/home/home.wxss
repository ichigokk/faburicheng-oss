.home-wrap {
  padding: 16rpx 24rpx 200rpx;
}

/* 顶部 header */
.app-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16rpx 8rpx 8rpx;
}
.header-text { display: flex; flex-direction: column; gap: 2rpx; }
.kicker { font-size: 22rpx; color: var(--muted); letter-spacing: 1rpx; }
.page-title { font-size: 40rpx; font-weight: 800; color: var(--text); letter-spacing: -0.5rpx; }
.back-today {
  background: var(--brand-soft);
  color: var(--brand-strong);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
}

/* 视图切换 + 期 */
.home-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 4rpx 20rpx;
  gap: 16rpx;
}
.segmented {
  display: inline-flex;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 4rpx;
}
.seg-btn {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--muted);
}
.seg-btn.active {
  background: var(--brand);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(143, 77, 91, 0.25);
}
.period-controls { display: flex; align-items: center; gap: 14rpx; }
.icon-button {
  width: 56rpx; height: 56rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  text-align: center;
  line-height: 52rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--brand);
}
.period-label { font-size: 26rpx; font-weight: 700; color: var(--text-soft); }

/* 发布提醒 banner */
.publish-alert {
  background: linear-gradient(135deg, #fff0e2, #ffe1c7);
  border: 1rpx solid #ffd4a8;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.alert-head { display: flex; justify-content: space-between; align-items: center; }
.alert-strong { font-weight: 800; font-size: 30rpx; color: #8a4a14; margin-right: 12rpx; }
.alert-sub { font-size: 22rpx; color: #b78057; }
.alert-list { margin-top: 14rpx; display: flex; flex-direction: column; gap: 10rpx; }
.alert-row {
  display: flex; align-items: center; gap: 10rpx;
  background: rgba(255,255,255,.55);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
}
.alert-time { font-weight: 700; color: #8a4a14; }
.alert-mid { flex: 1; color: var(--text-soft); }
.alert-arrow { color: #8a4a14; font-weight: 700; }
.alert-more { font-size: 22rpx; color: #b78057; text-align: center; }

/* day-card */
.day-card {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 20rpx 22rpx 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-sm);
  margin-bottom: 20rpx;
}
.day-card.is-today { border-color: var(--brand-soft); box-shadow: 0 6rpx 18rpx rgba(143, 77, 91, .12); }
.day-card.inline-day { margin-top: 16rpx; }
.day-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 8rpx;
}
.day-title { font-size: 32rpx; font-weight: 800; }
.day-label { font-size: 24rpx; color: var(--muted); }

.event-list { display: flex; flex-direction: column; gap: 12rpx; padding-top: 8rpx; }
.event-row {
  display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap;
  padding: 16rpx 18rpx;
  background: var(--surface-3);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
}
.event-row.shoot-row { background: linear-gradient(135deg, #fff4e2, #ffe9d4); border-color: #ffd9b5; }
.event-row.planned-row { background: linear-gradient(135deg, #f1ecff, #e2d6ff); border-color: #cdbcff; }
.avatar-mark {
  width: 56rpx; height: 56rpx;
  border-radius: 999rpx;
  overflow: hidden;
  color: white;
  text-align: center;
  line-height: 56rpx;
  font-weight: 700;
  font-size: 26rpx;
  flex-shrink: 0;
}
.avatar-mark image {
  width: 100%;
  height: 100%;
  display: block;
}
.event-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.event-title { font-size: 28rpx; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-sub { font-size: 22rpx; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-time {
  background: var(--brand-soft);
  color: var(--brand-strong);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.shoot-row .event-time { background: var(--amber-soft); color: #8a4a14; }
.planned-row .event-time { background: #d6c9ff; color: #4a3884; }
.event-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}
.event-actions button {
  margin: 0;
  padding: 0 14rpx;
  height: 44rpx;
  line-height: 42rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--brand-strong);
  border-color: var(--line);
}
.event-actions button.danger {
  color: #d83b50;
}

.empty-state.inner {
  padding: 20rpx 16rpx;
  border-style: dashed;
}

/* 周视图 */
.week-panel {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-sm);
}
.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.week-day {
  border-radius: 14rpx;
  background: var(--surface-3);
  padding: 14rpx 6rpx;
  display: grid;
  grid-template-rows: 54rpx minmax(44rpx, 1fr);
  align-items: center;
  gap: 8rpx;
  min-height: 130rpx;
}
.week-day.is-today { background: var(--brand-soft); }
.week-day.is-selected { background: var(--brand); color: white; }
.week-day.is-selected .week-wkd { color: rgba(255,255,255,.85); }
.week-head { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.week-num { font-size: 28rpx; font-weight: 700; }
.week-wkd { font-size: 20rpx; color: var(--muted); }
.dot-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  justify-content: center;
  align-items: flex-start;
  align-content: flex-start;
  min-height: 44rpx;
}
.dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; }
.dot.small { width: 10rpx; height: 10rpx; }
.calendar-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  overflow: hidden;
  color: white;
  font-size: 18rpx;
  line-height: 36rpx;
  text-align: center;
  font-weight: 700;
  flex-shrink: 0;
}
.calendar-avatar.small {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  font-size: 16rpx;
}
.calendar-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}
.calendar-avatar.is-shoot {
  box-shadow: 0 0 0 3rpx #d83b50, 0 0 0 6rpx #fff;
}

/* 月视图 */
.month-panel {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-sm);
}
.month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
}
.weekday {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  padding: 8rpx 0;
}
.month-grid-days { gap: 4rpx; }
.month-day {
  border-radius: 10rpx;
  background: var(--surface-3);
  padding: 8rpx 4rpx;
  display: grid;
  grid-template-rows: 32rpx minmax(36rpx, 1fr);
  align-items: center;
  gap: 4rpx;
  min-height: 86rpx;
}
.month-day.muted { background: transparent; opacity: 0.4; }
.month-day.is-today { background: var(--brand-soft); }
.month-day.is-selected { background: var(--brand); color: white; }
.month-num { font-size: 24rpx; font-weight: 700; }

/* 命令栏 */
.command-dock {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 16rpx 18rpx;
  box-shadow: 0 -6rpx 20rpx rgba(75, 35, 45, 0.08);
  z-index: 10;
}
/* ===== 单行胶囊输入条（对齐网页版） ===== */
.cmd-bar {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 12rpx 10rpx 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(75, 35, 45, 0.08);
}
.cmd-textarea {
  flex: 1;
  min-width: 0;
  min-height: 48rpx;
  max-height: 200rpx;
  padding: 12rpx 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.4;
}
.mic-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--surface-3);
  color: var(--brand-strong);
  font-size: 30rpx;
}
.mic-btn.recording {
  background: linear-gradient(135deg, #ffb86b, #ff8c4d);
  color: #fff;
}
.cmd-bar .send-btn {
  flex-shrink: 0;
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
.cmd-bar .send-btn::after { border: none; }
.cmd-bar .send-btn[disabled] { opacity: 0.55; }

/* ===== 滚动轻量化：下滑收成右下角悬浮球 ===== */
.cmd-bar,
.cmd-reply-inline,
.chat-toggle {
  transition: transform 0.24s ease, opacity 0.24s ease;
}
.command-ball {
  position: absolute;
  right: 8rpx;
  bottom: 0;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--brand);
  box-shadow: 0 8rpx 22rpx rgba(128, 82, 78, 0.32);
  opacity: 0;
  transform: scale(0.6) translateY(12rpx);
  pointer-events: none;
  transition: opacity 0.24s ease, transform 0.24s ease;
}
.command-ball-icon {
  font-size: 42rpx;
  color: #fff;
}
.command-dock.dock-ball .cmd-bar,
.command-dock.dock-ball .cmd-reply-inline,
.command-dock.dock-ball .chat-toggle {
  transform: translateY(130%);
  opacity: 0;
  pointer-events: none;
}
.command-dock.dock-ball .command-ball {
  opacity: 1;
  transform: scale(1) translateY(0);
  pointer-events: auto;
}
.cmd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}
.cmd-reply {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-soft);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.cmd-row .primary-button {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  margin: 0;
}

.cmd-top-row { display: flex; }
.cmd-left { flex: 1; min-width: 0; }
.cmd-reply-inline {
  margin: 0 16rpx 14rpx;
  padding: 14rpx 18rpx;
  background: var(--surface-3);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: var(--text-soft);
  line-height: 1.45;
  /* 单轮反馈最多 3 行 */
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.cmd-btns { display: flex; gap: 10rpx; align-items: center; flex-shrink: 0; }
.chat-toggle {
  display: inline-block;
  background: var(--brand-soft);
  color: var(--brand-strong);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* ===== 浮窗：作为 command-dock 的延伸，跟输入框一体 ===== */
.chat-panel-backdrop { display: none; }

.command-dock.has-chat {
  border-radius: 24rpx;
  padding: 0;
  overflow: hidden;
}
.command-dock.has-chat > .cmd-top-row,
.command-dock.has-chat > .cmd-row {
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.command-dock.has-chat > .cmd-top-row { padding-top: 16rpx; }
.command-dock.has-chat > .cmd-row { padding-bottom: 18rpx; }

.chat-panel {
  width: 100%;
  max-height: 60vh;
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.chat-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 22rpx 10rpx;
  border-bottom: 1rpx solid var(--line);
}
.chat-panel-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text);
}
.chat-panel-actions {
  display: flex;
  gap: 18rpx;
}
.chat-panel-link {
  font-size: 22rpx;
  color: var(--brand-strong);
  font-weight: 700;
}
.chat-panel-body {
  flex: 1;
  padding: 12rpx 18rpx 16rpx;
  overflow-y: auto;
}
.chat-bubble {
  display: block;
  max-width: 82%;
  padding: 14rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  margin: 10rpx 0;
  word-break: break-word;
  white-space: pre-wrap;
}
.chat-bubble.user {
  background: linear-gradient(135deg, #ffd9e0, #f5b8c5);
  color: #4f1d29;
  margin-left: auto;
  border-bottom-right-radius: 6rpx;
}
.chat-bubble.assistant {
  background: var(--surface-3);
  color: var(--text);
  margin-right: auto;
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 6rpx;
}
.chat-bubble.typing {
  opacity: 0.7;
  font-style: italic;
}
.chat-bubble.action-bubble {
  max-width: 100%;
}
.action-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}
.action-option {
  text-align: left;
  border: 1rpx solid var(--brand-soft);
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--brand-strong);
  font-size: 24rpx;
  font-weight: 700;
}
.action-option.primary {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}
.action-option.ghost {
  background: transparent;
  color: var(--muted);
  border-style: dashed;
}
.hold-button {
  background: var(--surface-3);
  color: var(--brand-strong);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  user-select: none;
}
.hold-button.recording {
  background: linear-gradient(135deg, #ffb86b, #ff8c4d);
  color: white;
  border-color: #ff8c4d;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 77, .35);
}
